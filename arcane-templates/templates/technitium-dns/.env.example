# Pin to a specific release when reproducible updates are required.
TECHNITIUM_IMAGE_TAG=latest

TECHNITIUM_CONTAINER_NAME=technitium-dns
TECHNITIUM_HOSTNAME=technitium-dns
TECHNITIUM_DOMAIN=dns.home.arpa
TECHNITIUM_ADMIN_PASSWORD=REPLACE_ME_IN_ARCANE

# Port 53 must be available on the Homebox host for client DNS queries.
TECHNITIUM_DNS_PORT=53
TECHNITIUM_DOH_PORT=443
TECHNITIUM_DOH3_PORT=443
TECHNITIUM_DOT_PORT=853
TECHNITIUM_DOQ_PORT=853
TECHNITIUM_WEB_PORT=5380
TECHNITIUM_WEB_HTTPS_PORT=53443
TECHNITIUM_CONFIG_PATH=./technitium-config
TECHNITIUM_LOG_PATH=./technitium-logs
