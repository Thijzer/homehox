# Generate an auth key in the Tailscale admin console:
# https://login.tailscale.com/admin/settings/keys
# Do not commit the real key. Set it in Arcane's project environment instead.
TS_AUTHKEY=tskey-auth-REPLACE_ME

TS_HOSTNAME=tailscale
TS_CONTAINER_NAME=tailscale
# Use a specific stable client version when reproducibility is required.
TAILSCALE_IMAGE_TAG=stable
