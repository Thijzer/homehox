# Listen for MQTT clients on the container's MQTT port.
listener 1883

# Require credentials. Generate /mosquitto/config/passwd on the host with:
# mosquitto_passwd -c ./mosquitto-config/passwd mqtt-user
allow_anonymous false
password_file /mosquitto/config/passwd

# Persist retained messages and subscriptions.
persistence true
persistence_location /mosquitto/data/

# Write broker logs to the mounted log directory.
log_dest file /mosquitto/log/mosquitto.log
