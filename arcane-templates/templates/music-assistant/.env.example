# Use a specific release tag for reproducible updates, or "latest" to track
# the latest stable release. "beta" is also available for beta releases.
MUSIC_ASSISTANT_IMAGE_TAG=latest

MUSIC_ASSISTANT_CONTAINER_NAME=music-assistant-server
MUSIC_ASSISTANT_DATA_PATH=./music-assistant-data
# Set this to the host directory containing local music. It may be empty if
# only streaming providers are used, but the directory must exist.
MUSIC_ASSISTANT_MEDIA_PATH=./music
MUSIC_ASSISTANT_LOG_LEVEL=info
